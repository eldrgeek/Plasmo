<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.plasmo.chromedebugmonitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/MikeWolf/Projects/Plasmo/chrome_debug_monitor.py</string>
        <string>--port</string>
        <string>9222</string>
        <string>--interval</string>
        <string>30</string>
